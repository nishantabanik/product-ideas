# Copy this file to .env and fill in your values:  cp .env.example .env
# .env is git-ignored, so your secrets stay on your Mac.

# Your IANA time zone, e.g. Europe/Berlin, Asia/Kolkata, America/New_York.
# Leave empty to use the Mac's system time zone.
TIMEZONE=

# Google Calendar is connected with `./run.sh google` (see README), not here.
# Outlook: the published ICS link of your calendar (read-only). Several links
# can be separated by commas.
OUTLOOK_ICS_URLS=

# Only if you don't use the Google sign-in: Google's "Secret address in iCal format".
GOOGLE_ICS_URLS=

# Garmin Connect login. Only needed for the first login; after that the app
# reuses the saved token in data/garmin_tokens/.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# How often the app syncs automatically when you open it (minutes).
AUTO_SYNC_MINUTES=60

# How many past days to pull on each sync.
SYNC_DAYS_BACK=7

# Optional: your own Microsoft app ID for Outlook (see README); leave empty to use the default
MS_CLIENT_ID=
