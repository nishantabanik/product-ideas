# Neon (or any Postgres) connection string
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Postiz: API key from Postiz Settings > Developers > Public API
POSTIZ_API_KEY=
# Postiz cloud default. Self-hosted: https://your-host/api/public/v1
POSTIZ_API_URL=https://api.postiz.com/public/v1

# Login for this app (single user)
APP_PASSWORD=
# Any long random string, used to sign the login cookie
SESSION_SECRET=
# Any long random string, Vercel sends it to the daily sync job
CRON_SECRET=

# Optional: a model for the written coach notes and reply suggestions, through our gateway.
# GATEWAY_API_URL can be the full chat endpoint (ending in /chat/completions or /messages) or just the base such as https://host/v1
GATEWAY_API_URL=
GATEWAY_API_KEY=
# The model name our gateway expects
GATEWAY_MODEL=
# Only if needed: openai (default) or anthropic. It is read from the URL when the URL ends in /messages.
GATEWAY_API_STYLE=
# Only if the gateway wants the key in another header, for example api-key
GATEWAY_API_KEY_HEADER=
# Only if the gateway needs more headers, as JSON, for example {"x-team":"growth"}
GATEWAY_EXTRA_HEADERS=
# Instead of a gateway we can sign in with GitHub Copilot on the Settings page (experimental). Model name, default gpt-4.1
COPILOT_MODEL=

# Optional: read and answer X comments from the app (our own X developer app, Read and write, billed per request by X)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Optional: send LinkedIn replies from the app (our own LinkedIn app with Share on LinkedIn)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Only if the site address differs from the one we open it on
APP_URL=
